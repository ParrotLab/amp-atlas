{
  "name": "app",
  "version": "1.0.1",
  "description": "AMP Atlas — a markdown editor over GitHub for the AMP team.",
  "main": "./out/main/index.js",
  "scripts": {
    "brand:dev": "bash scripts/brand-electron-dev.sh",
    "predev": "npm run brand:dev",
    "dev": "electron-vite dev",
    "postinstall": "npm run brand:dev || true",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "dotenv -e .env -- npm run release:build",
    "release:build": "electron-vite build && npm run release:tag && electron-builder --mac --publish always",
    "release:tag": "gh release create v$npm_package_version --repo ParrotLab/amp-atlas-releases --title $npm_package_version --notes \"AMP Atlas $npm_package_version\" --target main || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "chokidar": "^4.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.0",
    "lowlight": "^3.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.9"
  }
}
